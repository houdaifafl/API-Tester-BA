# ─────────────────────────────────────────────────────────────────────────────
# APICraft Backend — Environment Variable Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# The .env file is listed in .gitignore and must NEVER be committed.
#
# Steps:
#   1. cp .env.example .env
#   2. Replace every placeholder with a real value
#   3. Restart the backend
# ─────────────────────────────────────────────────────────────────────────────

# JWT signing secret — 256-bit random hex string.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET

# Frontend origin allowed by CORS — no trailing slash.
# Development:  http://localhost:3000
# Production:   https://yourdomain.com
FRONTEND_ORIGIN=http://localhost:3000

# Enforce secure cookies (HTTPS). Set to true in production.
# Development default: false
# Production example:  true
COOKIE_SECURE=false

# Flask debug mode. Set to true in development, false in production.
# Default: false (for production safety)
FLASK_DEBUG=false

# Symmetric encryption key for request history — valid 32-byte Fernet key.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode('utf-8'))"
HISTORY_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# Database Connection URI (SQLAlchemy format).
# SQL Server local development default:
#   mssql+pyodbc://@MSI\SQLEXPRESS01/API_tester?driver=ODBC+Driver+17+for+SQL+Server
# SQLite fallback default:
#   sqlite:///api_tester.db
DATABASE_URL=mssql+pyodbc://@MSI\SQLEXPRESS01/API_tester?driver=ODBC+Driver+17+for+SQL+Server



